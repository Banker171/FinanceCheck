{
  "name": "financecheck",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "test:e2e": "playwright test",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "test:desktop": "node --test tests/desktop.test.mjs",
    "test:electron": "npm run build && node scripts/test-electron.mjs",
    "test:upgrade": "node scripts/test-upgrade.mjs",
    "test:auto-update": "node scripts/test-auto-update.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "desktop/main.mjs",
  "description": "Личный финансовый план: долги, расходы и подушка безопасности",
  "author": "FinanceCheck",
  "license": "UNLICENSED"
}
